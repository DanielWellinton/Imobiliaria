@model IEnumerable<Model.Imovel>

@{
    ViewData["Title"] = "Painel Administrativo";
}

<div class="d-flex justify-content-between align-items-center mt-3 mb-4">
    <div>
        <h1 class="m-0 fw-bold">Painel de Imóveis</h1>
        <small class="text-muted">Gerenciamento interno do sistema</small>
    </div>
    <a asp-action="Create" class="btn btn-success fw-bold px-4">+ Novo Imóvel</a>
</div>

<div class="card shadow-sm border-start border-4 border-dark mb-4">
    <div class="card-body py-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label small fw-bold m-1">Categoria</label>
                <select name="categoria" class="form-select form-select-sm">
                    <option value="">Todas</option>
                    @foreach (var item in Html.GetEnumSelectList<Core.Enums.Enums.Categoria>())
                    {
                        <option value="@item.Value">@item.Text</option>
                    }
                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label small fw-bold m-1">Negócio</label>
                <select name="tipoNegocio" class="form-select form-select-sm">
                    <option value="">Todos</option>
                    @foreach (var item in Html.GetEnumSelectList<Core.Enums.Enums.TipoNegocio>())
                    {
                        <option value="@item.Value">@item.Text</option>
                    }
                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label small fw-bold m-1">Preço Mínimo</label>
                <input type="number" name="precoMin" class="form-control form-select-sm" placeholder="R$ Mín" step="0.01" />
            </div>

            <div class="col-md-2">
                <label class="form-label small fw-bold m-1">Preço Máximo</label>
                <input type="number" name="precoMax" class="form-control form-select-sm" placeholder="R$ Máx" step="0.01" />
            </div>

            <div class="col-md-3">
                <label class="form-label small fw-bold m-1">Pesquisar por título</label>
                <input type="text" name="busca" class="form-control form-select-sm" placeholder="Digite o título..." />
            </div>

            <div class="col-md-1 d-flex gap-1">
                <button type="submit" class="btn btn-dark btn-sm w-100 fw-bold">Filtrar</button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm" title="Limpar Filtros">↺</a>
            </div>
        </form>
    </div>
</div>

<div class="table-responsive shadow-sm rounded">
    <table class="table table-striped table-hover align-middle m-0">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Título</th>
                <th>Categoria</th>
                <th>Negócio</th>
                <th>Valor</th>
                <th>Cidade/UF</th>
                <th class="text-center" style="width: 180px;">Ações</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="7" class="text-center text-muted py-4">Nenhum registro encontrado para os filtros aplicados.</td>
                </tr>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td><strong>#@item.Id</strong></td>
                        <td class="fw-semibold">@item.Titulo</td>
                        <td><span class="badge bg-secondary">@item.Categoria</span></td>
                        <td><span class="badge bg-light text-dark border">@item.TipoNegocio</span></td>
                        <td class="text-success fw-bold">@item.Valor.ToString("C")</td>
                        <td>@(item.Endereco != null ? $"{item.Endereco.Cidade}/{item.Endereco.Estado}" : "Não informado")</td>
                        <td class="text-center">
                            <a asp-action="Update" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Excluir</a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>