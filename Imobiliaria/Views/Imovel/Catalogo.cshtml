@model IEnumerable<Model.Imovel>

@{
    ViewData["Title"] = "Portal de Imóveis";
}

<div class="container my-4">
    <div class="row text-center mb-4">
        <h1 class="display-5 fw-bold text-primary">Encontre o Imóvel dos Seus Sonhos</h1>
        <p class="lead text-muted">Filtre por categoria, tipo de negócio ou localização.</p>
    </div>

    <div class="card shadow-sm border-0 mb-5 bg-white">
        <div class="card-body p-4">
            <form method="get" asp-action="Catalogo" class="row g-3 align-items-end">

                <div class="col-md-3">
                    <label class="form-label fw-bold text-secondary small">Palavra-chave ou Cidade</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-search"></i></span>
                        <input type="text" name="busca" value="@Context.Request.Query["busca"]" class="form-control border-start-0" placeholder="Ex: São Paulo, Centro..." />
                    </div>
                </div>

                <div class="col-md-2">
                    <label class="form-label fw-bold text-secondary small">Finalidade</label>
                    <select name="tipoNegocio" class="form-select">
                        <option value="">Todas</option>
                        @foreach (var item in Html.GetEnumSelectList<Core.Enums.Enums.TipoNegocio>())
                        {
                            <option value="@item.Value" selected="@(Context.Request.Query["tipoNegocio"] == item.Value)">@item.Text</option>
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label fw-bold text-secondary small">Tipo do Imóvel</label>
                    <select name="categoria" class="form-select">
                        <option value="">Todos</option>
                        @foreach (var item in Html.GetEnumSelectList<Core.Enums.Enums.Categoria>())
                        {
                            <option value="@item.Value" selected="@(Context.Request.Query["categoria"] == item.Value)">@item.Text</option>
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label fw-bold text-secondary small">Preço Mínimo</label>
                    <input type="number" name="precoMin" value="@Context.Request.Query["precoMin"]" class="form-control" placeholder="R$ Mín" step="0.01" />
                </div>

                <div class="col-md-2">
                    <label class="form-label fw-bold text-secondary small">Preço Máximo</label>
                    <input type="number" name="precoMax" value="@Context.Request.Query["precoMax"]" class="form-control" placeholder="R$ Máx" step="0.01" />
                </div>

                <div class="col-md-1 d-flex gap-1">
                    <button type="submit" class="btn btn-primary w-100 fw-bold">Buscar</button>
                    <a asp-action="Catalogo" class="btn btn-outline-secondary btn-sm" title="Limpar Filtros">↺</a>
                </div>

            </form>
        </div>
    </div>

    <div class="row row-cols-1 row-cols-md-3 g-4">
        @if (!Model.Any())
        {
            <div class="col-12 text-center py-5">
                <h3 class="text-muted">Nenhum imóvel corresponde aos critérios de busca.</h3>
            </div>
        }
        else
        {
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 hover-shadow transition overflow-hidden">
                        
                        <div class="position-relative" style="height: 220px; overflow: hidden;">
                            <div class="position-absolute top-0 start-0 m-3" style="z-index: 10;">
                                <span class="badge @(item.TipoNegocio.ToString() == "Aluguel" ? "bg-success" : "bg-info text-dark") fs-6 px-3 py-2 shadow-sm">
                                    @item.TipoNegocio
                                </span>
                            </div>

                            <a asp-action="Details" asp-route-id="@item.Id">
                                @if (!string.IsNullOrEmpty(item.FotoUrl))
                                {
                                    <img src="@item.FotoUrl" class="card-img-top w-100 h-100 object-fit-cover img-zoom" alt="Foto de @item.Titulo">
                                }
                                else
                                {
                                    <img src="https://placehold.co/600x400/f8f9fa/6c757d?text=Imagem+Indisponivel" class="card-img-top w-100 h-100 object-fit-cover" alt="Imóvel sem foto">
                                }
                            </a>
                        </div>

                        <div class="card-body pt-3">
                            <span class="text-uppercase text-muted small fw-bold">@item.Categoria</span>
                            <h5 class="card-title fw-bold mt-1 text-dark text-truncate">@item.Titulo</h5>

                            <p class="card-text text-muted text-truncate-2" style="font-size: 0.9rem;">
                                @item.Descricao
                            </p>

                            <div class="mb-3">
                                <span class="text-muted small d-block"><i class="bi bi-geo-alt-fill"></i> Localização:</span>
                                <strong class="text-secondary">
                                    @(item.Endereco != null ? $"{item.Endereco.Cidade} - {item.Endereco.Estado}" : "Consultar localização")
                                </strong>
                            </div>

                            @if (!string.IsNullOrEmpty(item.Especificacoes))
                            {
                                <div class="p-2 bg-light rounded mb-3 small text-muted text-truncate">
                                    <strong>Especificações:</strong> @item.Especificacoes
                                </div>
                            }
                        </div>

                        <div class="card-footer bg-white border-0 d-flex justify-content-between align-items-center pb-3">
                            <h4 class="text-primary fw-bold m-0">@item.Valor.ToString("C")</h4>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm rounded-pill px-3">Ver Detalhes</a>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

<style>
    .hover-shadow:hover {
        transform: translateY(-5px);
        box-shadow: 0 .5rem 1.5rem rgba(0,0,0,.15) !important;
    }

        .hover-shadow:hover .img-zoom {
            transform: scale(1.05);
        }

    .img-zoom {
        transition: transform 0.3s ease-in-out;
    }

    .transition {
        transition: all 0.3s ease-in-out;
    }

    .text-truncate-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    
    .object-fit-cover {
        object-fit: cover;
    }
</style>